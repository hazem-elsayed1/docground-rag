# Streamlit generation provider: groq (recommended) or gemini. Gemini is used when this is unset.
DOCGROUND_GENERATION_PROVIDER=groq
# Used by the app with Groq, and by collect --provider groq
GROQ_API_KEY=
# Set to true only after verifying the free plan of the selected provider
DOCGROUND_FREE_TIER_CONFIRMED=false
# Optional: used by the app with Gemini, and by collect without --provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
